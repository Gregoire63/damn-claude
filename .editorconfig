# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Deux espaces en fin de ligne = retour à la ligne en Markdown. Les couper casse
# la mise en forme sans que rien ne le signale.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
