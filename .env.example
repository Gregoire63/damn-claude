# ============================================================
# Variables d'environnement — copier en .env pour le développement.
# En production (Netlify), tout se saisit dans l'interface : rien de ce
# fichier ne doit être commité rempli.
# ============================================================

# À qui appartient cette instance. Sert au nom affiché par le système au
# moment de poser le passkey, et à ce que le connecteur raconte à Claude.
# Facultatif : il se saisit aussi dans l'application.
NUXT_OWNER_NAME=

# ─── Coffre : validation des propositions de Claude ───────────────────
# NUXT_VAULT_SECRET est la SEULE variable obligatoire de ce fichier.
#   NUXT_VAULT_SECRET     : clé de signature (openssl rand -hex 32)
NUXT_VAULT_SECRET=

# Facultative. Le code de démarrage qui pose le premier passkey est
# fabriqué à chaque build et imprimé dans le journal de déploiement : il
# n'y a rien à poser ici. La renseigner revient à un secret permanent,
# qui l'emporte alors sur celui du build.
NUXT_VAULT_BOOTSTRAP=

# ─── Connecteur MCP (OAuth) ───────────────────────────────────────────
# Facultatives. Claude s'inscrit tout seul auprès du serveur (RFC 7591) :
# il n'y a ni identifiant ni secret à recopier dans le connecteur.
# Elles restent acceptées pour les instances installées avant.
NUXT_MCP_CLIENT_ID=
NUXT_MCP_CLIENT_SECRET=

# ─── Balance et montre Withings — https://developer.withings.com ──────
# L'URL de rappel déclarée chez la marque doit correspondre EXACTEMENT à :
#   https://<ton-domaine>/api/connect/withings/callback
# Ce chemin a changé quand les connecteurs sont devenus génériques (un
# fichier par marque, une route pour toutes) : /api/withings/callback rend
# aujourd'hui un 404. Une URL de rappel périmée ne se voit qu'au retour de
# la marque, après l'écran de consentement.
# Withings n'accepte en production que https sur le port 443 : pas de
# localhost, pas de http, pas de port exotique. Pour développer en local,
# déclare une application SÉPARÉE — une URL localhost sur l'application de
# production la fait retomber dans la phase d'intégration, limitée à dix
# utilisateurs.
# Le secret ne doit jamais passer sous runtimeConfig.public : il resterait
# dans le bundle client.
NUXT_WITHINGS_CLIENT_ID=
NUXT_WITHINGS_CLIENT_SECRET=

# ─── Montre Fitbit — https://dev.fitbit.com ───────────────────────────
# Vides, le fournisseur ne s'affiche pas dans l'application : mieux vaut
# pas de bouton qu'un bouton qui échoue.
#   https://<ton-domaine>/api/connect/fitbit/callback
NUXT_FITBIT_CLIENT_ID=
NUXT_FITBIT_CLIENT_SECRET=
